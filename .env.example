# Copy to .env.local for local testing, and add the same values in your Vercel project settings.

# Required. Your mail provider's SMTP server and login.
# Gmail: host smtp.gmail.com, port 465, user = your Gmail address, pass = a 16-character App Password
# (Google Account > Security > 2-Step Verification > App passwords). Your normal password won't work.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# Optional. Defaults to true for port 465 and false otherwise (587 upgrades with STARTTLS).
SMTP_SECURE=

# Optional. Where messages are delivered. Defaults to the email in data/site.ts.
CONTACT_TO_EMAIL=

# Optional. Sender shown on the email. Defaults to SMTP_USER. Most providers reject other addresses.
CONTACT_FROM_EMAIL=
